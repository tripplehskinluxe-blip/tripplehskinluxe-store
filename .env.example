# Copy to .env.local (never commit it). Use TEST keys until go-live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# EMAIL (Resend). Optional until you have a verified domain: with these empty the shop works and simply sends no emails.
# EMAIL_FROM must use a domain you have verified in Resend, e.g.  Tripple H Skin Luxe <orders@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Optional: where customer replies go
EMAIL_REPLY_TO=

# SECRET ADMIN ADDRESS. The admin is at /<this value>. "/admin" does not exist.
# Use a long random value (12+ characters) and keep it private. Generate one with:
#   node -e "console.log('ops-'+require('crypto').randomBytes(9).toString('hex'))"
# If this is empty or shorter than 12 characters, the admin is switched OFF.
NEXT_PUBLIC_ADMIN_PATH=
